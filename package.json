{
  "name": "shengcheng",
  "version": "0.1.3",
  "private": true,
  "description": "DSH plugin: generate images with logged-in Grok/GPT accounts, and videos with Grok.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./locale/*.json": "./locale/*.json"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "0.87.1"
  },
  "packageManager": "pnpm@11.7.0",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": ["@deepseek-ai/dsh-client-ui-plugin-manager"]
    }
  }
}
